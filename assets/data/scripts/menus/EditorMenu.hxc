import funkin.editors.chart.ChartEditor;
import funkin.editors.sprites.SpriteEditor;

var editors:Array<String> = ['Chart Editor', 'Sprite Editor'];
var editorGrp:Array<SockitText> = [];
var curEditor:Int = 0;
var bg:SockitSprite;

function onLoad() {
    bg = new SockitSprite(0, -20);
    bg.name = 'BG';
}

function onCreate() {
    bg.setImage('images/menuBG');
    bg.color = 0x00C400;
    bg.setGraphicSize(bg.width * 1.1);
    bg.scrollFactor.set(0, 0.2);
    add(bg);
    for (i in 0...editors.length) {
        var editorItem:SockitText = new SockitText(0, 0 + (i * 120), editors[i]);
        editorGrp.push(editorItem);
        trace(editors[i]);
    }
    for (item in editorGrp) {
        add(item);
    }
    changeEditor(0);
}

function onUpdate() {
    if (controls.UP_P) {
        changeEditor(-1);
    }
    if (controls.DOWN_P) {
        changeEditor(1);
    }
    if (controls.ACCEPT) {
        switch(editors[curEditor]) {
            case 'Chart Editor':
                FlxG.switchState(new ChartEditor());
            case 'Sprite Editor':
                FlxG.switchState(new SpriteEditor());
        }
    }
     if (controls.BACK) {
        switchState('data/scripts/menus/MainMenu');
    }
}

function onUpdatePost() {
    
}

function changeEditor(sel:Int = 0) {
    curEditor += sel;

    if (curEditor > editors.length - 1)
        curEditor = 0;
    if (curEditor < 0)
        curEditor = editors.length - 1;

    for (item in 0...editors.length) {
        if (item == curEditor) {
            editorGrp[item].alpha = 1;
        }   
        if (item != curEditor) {
            editorGrp[item].alpha = 0.6;
        }
    }
}